# Copy this file to .env and replace every change-me value.
POSTGRES_DB=leadflow
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=change-me-use-a-long-random-password
SESSION_COOKIE_SECURE=false

# Optional Yandex AI Studio extraction. Keep disabled until both values below
# are configured. Never commit a real key.
AI_ENABLED=false
YANDEX_API_KEY=
YANDEX_MODEL_URI=

# Optional Telegram delivery scheduled by n8n. Keep disabled until the bot,
# destination chat, and a random service token are configured.
NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATIONS_SERVICE_TOKEN=change-me-use-a-long-random-service-token
NOTIFICATION_REMINDER_MINUTES=30
MANAGER_PUBLIC_URL=http://localhost:8080

# Optional n8n Compose profile. n8n metadata uses its own PostgreSQL service.
N8N_POSTGRES_DB=leadflow_n8n
N8N_POSTGRES_USER=leadflow_n8n
N8N_POSTGRES_PASSWORD=change-me-use-a-different-long-random-password
N8N_ENCRYPTION_KEY=change-me-use-a-long-random-encryption-key
