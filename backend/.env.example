# Prefer components: URL-special password characters are encoded safely.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leadflow
DB_USER=leadflow
DB_PASSWORD=leadflow
DB_CONNECT_TIMEOUT_SECONDS=5
# Optional full SQLAlchemy URL override (takes precedence over DB_*).
# DATABASE_URL=postgresql+psycopg://leadflow:leadflow@localhost:5432/leadflow
APP_ORIGIN=http://localhost:8080
# Comma-separated exact browser origins. Example: http://127.0.0.1:5173
ADDITIONAL_ALLOWED_ORIGINS=
# Only configure proxy IPs/CIDRs that overwrite X-Forwarded-For.
TRUSTED_PROXY_IPS=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=24
SESSION_COOKIE_NAME=leadflow_session
LOGIN_RATE_LIMIT=5
PUBLIC_LEAD_RATE_LIMIT=20
RATE_LIMIT_WINDOW_SECONDS=60
EXTRACTION_RETRY_RATE_LIMIT=10

# Yandex AI Studio extraction. Keep disabled until both secrets are supplied.
AI_ENABLED=false
YANDEX_API_KEY=
YANDEX_MODEL_URI=
YANDEX_API_URL=https://ai.api.cloud.yandex.net/foundationModels/v1/completion
YANDEX_DATA_LOGGING_ENABLED=false
EXTRACTION_POLL_INTERVAL_SECONDS=2
EXTRACTION_REQUEST_TIMEOUT_SECONDS=20
EXTRACTION_MAX_ATTEMPTS=4
EXTRACTION_LEASE_SECONDS=60
EXTRACTION_RETRY_BASE_SECONDS=5

# Optional n8n-scheduled Telegram notifications. Keep disabled until all secrets are set.
NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Test/fixture override only; production should use the official HTTPS endpoint.
TELEGRAM_API_BASE_URL=https://api.telegram.org
NOTIFICATIONS_SERVICE_TOKEN=
NOTIFICATION_REMINDER_MINUTES=30
MANAGER_PUBLIC_URL=http://localhost:8080
NOTIFICATION_REQUEST_TIMEOUT_SECONDS=10
NOTIFICATION_LEASE_SECONDS=60
NOTIFICATION_MAX_ATTEMPTS=4
NOTIFICATION_RETRY_BASE_SECONDS=5
NOTIFICATION_RETRY_CAP_SECONDS=300
